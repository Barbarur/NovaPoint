<Page x:Class="NovaPointWPF.Pages.Solutions.Report.ItemReportForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:NovaPointWPF.Pages.Solutions.Report"
      xmlns:usercontrols="clr-namespace:NovaPointWPF.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="600"
      Title="ItemReportForm">

    <Grid Margin="0,0,0,16">
                
        <StackPanel>

            <usercontrols:AdminForm
                x:Name="AdminF"/>

            <usercontrols:SiteTenantForm
                x:Name="SiteF"/>

            <usercontrols:ListForm
                x:Name="ListForm"/>

            <usercontrols:ItemForm
                x:Name="ItemForm"/>

        </StackPanel>

    </Grid>
</Page>
